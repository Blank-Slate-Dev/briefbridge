<tier type="longtitle" id="frnt-lt">
<parentattributes>
<attrib name="guid" value="_a78d9a64-aaac-44cb-b0b7-395b9f78c98f"></attrib>
<attrib name="id" value="frnt-lt"></attrib></parentattributes>

<block><txt break.before="1">An Act to provide that consultation of regional
communities by government bodies and agencies be carried out in a proper and
effective manner.</txt></block></tier>
</content>


<content type="body">

<level type="clause" id="sec.1">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="spent.amends" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_7c08e09c-528e-4120-a2c4-8636c8d3add9"></attrib>
<attrib name="id" value="sec.1"></attrib></parentattributes>

<head>
<no>1</no><heading guid="_6e8c89b1-d9c0-4b89-a197-f93c213e3709"
id="sec.1-he"><b>Name of Act</b></heading></head>
<block><txt break.before="1">This Act is the <legref refid="act-2024-070"
jurisd="NSW" type="act" check="unknown"><name emphasis="yes"><i>Regional
Communities (Consultation Standards) Act
2024</i></name></legref>.</txt></block></level>


<level type="clause" id="sec.2">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="spent.amends" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_1116d6bd-3e40-4a10-a5cc-e64d3e2a61db"></attrib>
<attrib name="id" value="sec.2"></attrib></parentattributes>

<head>
<no>2</no><heading guid="_4aecb73c-81c1-49ee-a9d4-6b1736d81228"
id="sec.2-he"><b>Commencement</b></heading></head>
<block><txt break.before="1">This Act commences on a day or days to be
appointed by proclamation.</txt></block></level>


<level type="clause" id="sec.3">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="spent.amends" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_11678b00-7752-4f01-ab53-3ad4ffa8f0ae"></attrib>
<attrib name="id" value="sec.3"></attrib></parentattributes>

<head>
<no>3</no><heading guid="_989a3de2-2eee-431c-970f-60f7d6c1212c"
id="sec.3-he"><b>Definition</b></heading></head>
<block><txt break.before="1">In this Act&#8212;</txt>
<deflist>
<block><txt break.before="1"><defterm type="definition"
guid="_a140ebf7-a6fa-45e2-a8a7-9b72cfc14eac"
id="sec.3-def.regionalcommunity"><b><i>regional community</i></b></defterm>
means a community outside the Greater Sydney Region.</txt></block></deflist>
</block>
<note type="legtext" guid="_f142b988-7c38-48bd-ac29-22f35195ed8b"
id="sec.3-note"><heading guid="_f49f526c-dfe0-423f-b6e8-fdf553ad144e"
id="sec.3-note-he"><b>Note&#8212;</b></heading>
<block><txt break.before="1">The <legref refid="act-1987-015" jurisd="NSW"
type="act" check="unknown"><name emphasis="yes"><i>Interpretation Act
1987</i></name></legref> contains definitions and other provisions that affect
the interpretation and application of this Act.</txt></block></note>
</level>


<level type="clause" id="sec.4">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="spent.amends" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_cc884a9e-d0e9-4406-89e2-511e4b997736"></attrib>
<attrib name="id" value="sec.4"></attrib></parentattributes>

<head>
<no>4</no><heading guid="_39cb57dd-4e4e-426e-983b-7ccee80b5574"
id="sec.4-he"><b>Consultation with regional communities to comply with
standards</b></heading></head>

<tier type="subclause" id="sec.4-ssec.1">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_ef99b7e3-1504-45a5-9427-d019415d399f"></attrib>
<attrib name="id" value="sec.4-ssec.1"></attrib></parentattributes>

<head>
<no>(1)</no></head>
<block><txt break.before="1">A consultation with a regional community must be
carried out having regard to the consultation guide if the consultation
is&#8212;</txt>
<list number.type="default" unnumbered.indent="0">
<li provision.type="other" affected.by.uncommenced="0"
guid="_8a8b9168-f479-4403-88cf-e32773d5bf96" id="sec.4-ssec.1-para1.a">
<no>(a)</no>
<block><txt break.before="1">primarily directed to, or primarily impacts on,
the health, cultural, environmental, economic, educational or other well-being
of persons in the regional community, and</txt></block></li>
<li provision.type="other" affected.by.uncommenced="0"
guid="_424bb9b4-3a22-4091-bd27-27fac0896910" id="sec.4-ssec.1-para1.b">
<no>(b)</no>
<block><txt break.before="1">to be carried out by or for the State, a NSW
Government agency or a statutory body representing the
Crown.</txt></block></li></list>
</block></tier>


<tier type="subclause" id="sec.4-ssec.2">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_e7040ff4-085d-42fe-9894-d9d6dd3b0f74"></attrib>
<attrib name="id" value="sec.4-ssec.2"></attrib></parentattributes>

<head>
<no>(2)</no></head>
<block><txt break.before="1">This section does not apply to&#8212;</txt>
<list number.type="default" unnumbered.indent="0">
<li provision.type="other" affected.by.uncommenced="0"
guid="_23be29fd-77e3-4bb3-a77c-46fdf1da6a90" id="sec.4-ssec.2-para1.a">
<no>(a)</no>
<block><txt break.before="1">a consultation required by or under another Act
to be carried out in a specified way, or</txt></block></li>
<li provision.type="other" affected.by.uncommenced="0"
guid="_39978a15-1d7f-45f6-90f4-a10eaf2e6785" id="sec.4-ssec.2-para1.b">
<no>(b)</no>
<block><txt break.before="1">a consultation in relation to the exercise of a
function that is not subject to the direction or control of a
Minister.</txt></block></li></list>
</block></tier>


<tier type="subclause" id="sec.4-ssec.3">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_e942e9b7-cd87-41d3-8235-ebd20f8a8b88"></attrib>
<attrib name="id" value="sec.4-ssec.3"></attrib></parentattributes>

<head>
<no>(3)</no></head>
<block><txt break.before="1">A failure to comply with this section does not
affect the validity of a consultation.</txt></block></tier>


<tier type="subclause" id="sec.4-ssec.4">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_9de05681-5062-47ac-aff1-004180cc6a0f"></attrib>
<attrib name="id" value="sec.4-ssec.4"></attrib></parentattributes>

<head>
<no>(4)</no></head>
<block><txt break.before="1">In this section&#8212;</txt>
<deflist>
<block><txt break.before="1"><defterm type="definition"
guid="_86985158-6ed6-4206-87de-5768e492cd15"
id="sec.4-ssec.4-def.consultationguide"><b><i>consultation
guide</i></b></defterm> means a Consultation with Regional Communities Guide
issued from time to time by the Premier and published in the
Gazette.</txt></block></deflist>
</block></tier>
</level>
</content>


