<tier type="longtitle" id="frnt-lt">
<parentattributes>
<attrib name="guid" value="_4a53e475-fc08-4e68-b845-52471ecd98e5"></attrib>
<attrib name="id" value="frnt-lt"></attrib></parentattributes>

<block><txt break.before="1">An Act to provide that the rules of equity shall
prevail over the rules of the common law in cases of conflict or variance; to
extend the defences available in inferior courts; to repeal certain sections
of the <legref jurisd="NSW" type="act" check="unknown"><name
emphasis="yes"><i>District Courts Act 1912</i></name></legref> and the <legref
jurisd="NSW" type="act" check="unknown" refid="act-1970-052"><name
emphasis="yes"><i>Supreme Court Act 1970</i></name></legref>; and for purposes
connected therewith.</txt></block></tier>
</content>


<content type="body">

<level type="clause" id="sec.1">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="spent.amends" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_ab88d16c-b6cf-4472-a1bf-3bcc8beab65a"></attrib>
<attrib name="id" value="sec.1"></attrib></parentattributes>

<head>
<no>1</no><heading guid="_88d65435-fa6a-4516-9f98-120e8154ee30"
id="sec.1-he"><b>Name of Act</b></heading></head>
<block><txt break.before="1">This Act may be cited as the <legref jurisd="NSW"
type="act" check="unknown" refid="act-1972-028"><name emphasis="yes"><i>Law
Reform (Law and Equity) Act 1972</i></name></legref>.</txt></block></level>


<level type="clause" id="sec.2">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="spent.amends" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_81fcf1ee-3eb7-45df-8e9d-c57476339a04"></attrib>
<attrib name="id" value="sec.2"></attrib></parentattributes>

<head>
<no>2</no><heading guid="_a27165d2-3854-49a0-ba37-7dda2919bdf7"
id="sec.2-he"><b>Commencement</b></heading></head>
<block><txt break.before="1">This Act shall commence on a day to be appointed
by the Governor and notified by proclamation published in the
Gazette.</txt></block></level>


<level type="clause" id="sec.3">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="spent.amends" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_6ba6b3c2-b77a-4304-b6cd-5215cc261574"></attrib>
<attrib name="id" value="sec.3"></attrib></parentattributes>

<head>
<no>3</no><heading guid="_9fa812ae-c1a7-444c-b833-aae3831e690b"
id="sec.3-he"><b>Repeal and amendment</b></heading></head>

<tier type="subclause" id="sec.3-ssec.1">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_8abda0c3-bf78-4c29-bab2-a45a1360bb38"></attrib>
<attrib name="id" value="sec.3-ssec.1"></attrib></parentattributes>

<head>
<no>(1)</no></head>
<block><txt break.before="1">Section seventy-four of the <legref jurisd="NSW"
type="act" check="unknown"><name emphasis="yes"><i>District Courts Act
1912</i></name></legref> is repealed, but this repeal does not affect
proceedings commenced in a district court before the commencement of this
Act.</txt></block></tier>


