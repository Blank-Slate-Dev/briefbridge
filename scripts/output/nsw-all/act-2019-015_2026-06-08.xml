<no>2</no><heading guid="_1abfe178-ae64-4184-881e-7db8f87a244a"
id="sec.2-he"><b>Commencement</b></heading></head>
<block><txt break.before="1">This Act commences on the date of assent to this
Act.</txt></block></level>


<level type="clause" id="sec.3">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="spent.amends" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
