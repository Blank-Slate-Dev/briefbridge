<attrib name="id" value="sch.1-sec.1-ssec.1"></attrib></parentattributes>

<head>
<no>(1)</no></head>
<block><txt break.before="1">A regulation (a <defterm type="definition"
guid="_879d0cdf-20d7-4cc2-bb3b-a2815763e083"
id="sch.1-sec.1-def.transitionalregulation"><b><i>transitional
regulation</i></b></defterm>) may make provision about a matter for
which&#8212;</txt>
<list number.type="default" unnumbered.indent="0">
<li provision.type="other" affected.by.uncommenced="0"
guid="_a2c7f4de-933b-4b1c-b219-34d29fcb3d2a" id="sch.1-sec.1-ssec.1-para1.a">
<no>(a)</no>
<block><txt break.before="1">it is necessary to make provision to allow or
facilitate the doing of any thing to achieve the transition to the operation
of this Act, and</txt></block></li>
<li provision.type="other" affected.by.uncommenced="0"
guid="_2fd090d8-5f89-49cd-b618-55b37a9f2a16" id="sch.1-sec.1-ssec.1-para1.b">
<no>(b)</no>
<block><txt break.before="1">this Act does not make provision or sufficient
provision.</txt></block></li></list>
</block></tier>


<tier type="subclause" id="sch.1-sec.1-ssec.2">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_5f67ec5f-bc6e-43fa-8816-d6887070c314"></attrib>
<attrib name="id" value="sch.1-sec.1-ssec.2"></attrib></parentattributes>

<head>
<no>(2)</no></head>
<block><txt break.before="1">A transitional regulation may have retrospective
operation to a day not earlier than the commencement of this
Act.</txt></block></tier>


<tier type="subclause" id="sch.1-sec.1-ssec.3">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_e59d962e-e4db-452d-8933-ce18f15899a0"></attrib>
<attrib name="id" value="sch.1-sec.1-ssec.3"></attrib></parentattributes>

<head>
<no>(3)</no></head>
<block><txt break.before="1">A transitional regulation must declare it is a
transitional regulation.</txt></block></tier>


<tier type="subclause" id="sch.1-sec.1-ssec.4">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_af815585-58e3-4f66-a9fa-31d229312c3b"></attrib>
<attrib name="id" value="sch.1-sec.1-ssec.4"></attrib></parentattributes>

<head>
<no>(4)</no></head>
<block><txt break.before="1">This clause and any transitional regulations
expire 2 years after the commencement of this Act.</txt></block></tier>
</level>


