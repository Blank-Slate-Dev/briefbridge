<head>
<no>1</no><heading guid="_d27cf21d-4a0d-47b1-93b9-691ee6f00188"
id="sec.1-he"><b>Name of Act</b></heading></head>
<block><txt break.before="1">This Act is the <legref type="act" jurisd="NSW"
check="unknown" refid="act-2016-066"><name emphasis="yes"><i>Rock Fishing
Safety Act 2016</i></name></legref>.</txt></block></level>


<level type="clause" id="sec.2">
