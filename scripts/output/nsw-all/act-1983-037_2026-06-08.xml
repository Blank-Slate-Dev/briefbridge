<head>
<no>1</no><heading guid="_2792adc8-8f71-4714-8375-e996af53f125"
id="sch.4-sec.1-he"><b>Revocation of State forests</b></heading></head>
<block><txt break.before="1">Section 3 has effect notwithstanding the
provisions of the <legref refid="act-1916-055" jurisd="NSW" type="act"
check="unknown"><name emphasis="yes"><i>Forestry Act
1916</i></name></legref>.</txt></block></level>
</content>


<content type="auto-inserted">

<level type="clause" id="sch.4-sec.2">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
