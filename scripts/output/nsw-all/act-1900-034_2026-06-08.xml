refid="act-1900-034" jurisd="NSW" type="act" check="unknown"><name
emphasis="yes"><i>Witnesses Examination Act
1900</i></name></legref>.</txt></block></level>


<level type="clause" id="sec.2">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
