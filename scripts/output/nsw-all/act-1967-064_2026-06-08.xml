<head>
<no>1</no><heading guid="_1d9cd02b-6459-423c-aa3b-48ff90df1787"
id="sec.1-he"><b>Name of Act and commencement</b></heading></head>

<tier type="subclause" id="sec.1-ssec.1">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_86c983b8-adf0-4c56-8c43-468f0e7d9718"></attrib>
<attrib name="id" value="sec.1-ssec.1"></attrib></parentattributes>

<head>
<no>(1)</no></head>
<block><txt break.before="1">This Act may be cited as the <legref
refid="act-1967-064" jurisd="NSW" type="act" check="unknown"><name
emphasis="yes"><i>Civil Aviation (Carriers&#8217; Liability) Act
1967</i></name></legref>.</txt></block></tier>


<tier type="subclause" id="sec.1-ssec.2">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_5032f6dc-6339-48e7-8a5e-051de3e533bc"></attrib>
