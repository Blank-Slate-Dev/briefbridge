<block><txt break.before="1">An Act to make provision for homes for disabled
members of the naval and military forces, and for the dependents of such
members who have died; for that purpose to provide for the issue of Crown
grants of land and for aiding Voluntary Workers&#8217; Associations to
purchase materials; to amend the <legref jurisd="NSW" type="act"
check="unknown"><name emphasis="yes"><i>Public Instruction Act of
1880</i></name></legref> and certain other Acts; and for purposes consequent
thereon or incidental thereto.</txt></block></tier>
</content>


<content type="body">

<level type="clause" id="sec.1">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="spent.amends" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
