<block><txt break.before="1">Part 5A of the <legref refid="act-1923-001"
jurisd="NSW" type="act" check="unknown"><name emphasis="yes"><i>Sale of Goods
Act 1923</i></name></legref> is repealed.</txt></block></level>


<level type="clause" id="sec.5">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="spent.amends" value="0"></attrib>
