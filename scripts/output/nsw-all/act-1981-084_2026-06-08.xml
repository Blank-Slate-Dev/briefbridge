<content type="historynote"><txt break.before="1"><b>s 3:</b> Rep 1999 No 94,
Sch 4.111 [1].</txt></content>
</level>


<level type="clause" id="sec.4">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="spent.amends" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_9ef9a16a-b403-4e9a-ac00-a983c2a4da64"></attrib>
