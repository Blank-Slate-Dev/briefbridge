<attrib name="id" value="frnt-lt"></attrib></parentattributes>

<block><txt break.before="1">An Act to provide that a person convicted of, or
found to have committed, a felony shall not be incapable of instituting and
maintaining civil proceedings in any court.</txt></block></tier>
</content>


<content type="body">

