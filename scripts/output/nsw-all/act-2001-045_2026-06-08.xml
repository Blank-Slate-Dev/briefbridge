<head>
<no>1</no><heading guid="_6dfbde71-a686-4dad-be85-fde3508c9f54"
id="sec.1-he"><b>Name of Act</b></heading></head>
<block><txt break.before="1">This Act is the <legref refid="act-2001-045"
jurisd="NSW" type="act" check="unknown"><name emphasis="yes"><i>Co-operative
Schemes (Administrative Actions) Act
2001</i></name></legref>.</txt></block></level>


<level type="clause" id="sec.2">
<parentattributes>
