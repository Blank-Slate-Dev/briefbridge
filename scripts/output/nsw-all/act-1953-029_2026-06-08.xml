<block><txt break.before="1">An Act to make provision, consequential on the
enactment of the <legref jurisd="CTH" type="act" check="unknown"><name
emphasis="yes"><i>Commonwealth Bank Act 1953</i></name></legref> by the
Parliament of the Commonwealth, with respect to the construction of references
in State legislation to the Commonwealth Bank of Australia; and for purposes
connected therewith.</txt></block></tier>
</content>


<content type="body">

<level type="clause" id="sec.1">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="spent.amends" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
