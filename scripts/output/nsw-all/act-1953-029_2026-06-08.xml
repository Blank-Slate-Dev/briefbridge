<attrib name="id" value="sec.1"></attrib></parentattributes>

<head>
<no>1</no><heading guid="_676d9d7f-a584-4550-a4aa-85dac5a9c895"
id="sec.1-he"><b>Name of Act and commencement</b></heading></head>

<tier type="subclause" id="sec.1-ssec.1">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_ea6ca047-cc5f-4b45-84df-f0d4e3b62c11"></attrib>
<attrib name="id" value="sec.1-ssec.1"></attrib></parentattributes>

<head>
<no>(1)</no></head>
<block><txt break.before="1">This Act may be cited as the <legref jurisd="NSW"
type="act" check="unknown" refid="act-1953-029"><name
emphasis="yes"><i>Commonwealth Bank (Interpretation) Act
1953</i></name></legref>.</txt></block></tier>


<tier type="subclause" id="sec.1-ssec.2">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_5cbd2d16-0a43-4622-a37c-13d05f51e628"></attrib>
<attrib name="id" value="sec.1-ssec.2"></attrib></parentattributes>

<head>
<no>(2)</no></head>
<block><txt break.before="1">This Act shall be deemed to have commenced upon
the third day of December, one thousand nine hundred and
fifty-three.</txt></block></tier>
</level>


<level type="clause" id="sec.2">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="spent.amends" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_9c4b49a4-1166-42b9-988b-afe5b46444e6"></attrib>
<attrib name="id" value="sec.2"></attrib></parentattributes>

<head>
<no>2</no><heading guid="_5fd5f69f-9d9e-4b0f-8ac7-d6ea9ee03d18"
id="sec.2-he"><b>References to Commonwealth Bank of
Australia</b></heading></head>

<tier type="subclause" id="sec.2-ssec.1">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_17dd080b-45f1-4611-8fb0-d2477918c217"></attrib>
<attrib name="id" value="sec.2-ssec.1"></attrib></parentattributes>

<head>
<no>(1)</no></head>
<block><txt break.before="1">As on and from the commencement of this Act a
reference in the <legref jurisd="NSW" type="act" check="unknown"><name
emphasis="yes"><i>Moratorium Act 1932&#8211;1950</i></name></legref> to the
Commonwealth Bank of Australia shall be read and construed as including a
reference to the Commonwealth Trading Bank of Australia, the Reserve Bank of
Australia and the Commonwealth Development Bank of
Australia.</txt></block></tier>


<tier type="subclause" id="sec.2-ssec.2">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_a626b7c2-cf3f-407a-9490-8fdca7907dde"></attrib>
<attrib name="id" value="sec.2-ssec.2"></attrib></parentattributes>

<head>
<no>(2)</no></head>
<block>
<list number.type="default" unnumbered.indent="0">
<li provision.type="other" affected.by.uncommenced="0"
guid="_0d9781ab-8a50-41a7-a057-b4d2f3c38a49" id="sec.2-ssec.2-para1.a">
<no>(a)</no>
<block><txt break.before="1">In this subsection:</txt>
<deflist>
<block><txt break.before="1"><defterm type="definition"
guid="_06b47880-ee87-4853-a45e-cb5ce345b530"
id="sec.2-ssec.2-def.Act"><b><i>Act</i></b></defterm> means any Act (other
than the <legref jurisd="NSW" type="act" check="unknown"><name
emphasis="yes"><i>Anzac Memorial (Building) Act
1923&#8211;1934</i></name></legref>, the <legref jurisd="NSW" type="act"
check="unknown" refid="act-1946-044"><name emphasis="yes"><i>Coal Industry Act
1946</i></name></legref>, the <legref jurisd="NSW" type="act"
check="unknown"><name emphasis="yes"><i>Commonwealth and State Banks
Agreements Ratification Act 1931</i></name></legref>, the <legref jurisd="NSW"
type="act" check="unknown"><name emphasis="yes"><i>Commonwealth and State
Banks Agreement Ratification Act 1935</i></name></legref>, the <legref
jurisd="NSW" type="act" check="unknown"><name emphasis="yes"><i>Commonwealth
and State Bank Agreement Ratification Act 1937</i></name></legref>, the
<legref jurisd="NSW" type="act" check="unknown"><name
emphasis="yes"><i>Government Savings Bank (Amendment) Act
1931</i></name></legref> and the <legref jurisd="NSW" type="act"
check="unknown"><name emphasis="yes"><i>Moratorium Act
1932&#8211;1950</i></name></legref>) passed before the commencement of this
Act.</txt></block>
<block><txt break.before="1"><defterm type="definition"
guid="_493bfe4c-0127-4b70-9254-ed45a319c256"
id="sec.2-ssec.2-def.Regulation"><b><i>Regulation</i></b></defterm> means any
regulation, rule, by-law, ordinance or other like instrument made under any
Act before the commencement of this Act.</txt></block></deflist>
</block></li>
<li provision.type="other" affected.by.uncommenced="0"
guid="_effc77ff-e2bb-466b-b3df-d7604a05ea97" id="sec.2-ssec.2-para1.b">
<no>(b)</no>
<block><txt break.before="1">As on and from the commencement of this Act a
reference in any Act or regulation to the Commonwealth Bank of Australia or to
the Commonwealth Bank shall, subject to paragraph (c) of this subsection, be
read and construed as a reference to the Commonwealth Trading Bank of
Australia.</txt></block></li>
<li provision.type="other" affected.by.uncommenced="0"
guid="_b48146a9-14ab-4134-b69d-91a8d3e9e6c2" id="sec.2-ssec.2-para1.c">
<no>(c)</no>
<block><txt break.before="1">The Governor may, by order, published in the
Gazette, declare that, as on and from a day to be specified in the order, the
provisions of paragraph (b) of this subsection shall not apply to any Act or
regulation specified in the order or, as the case may be, to such provisions
of any Act or regulation as may be so specified.</txt></block>
<block><txt break.before="1">The day so specified may be earlier than the date
on which the order is made or published in the Gazette.</txt></block>
<block><txt break.before="1">Any order under this paragraph shall have effect
according to its tenor.</txt></block></li></list>
</block></tier>


<tier type="subclause" id="sec.2-ssec.3" status="repealed">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_725a1c22-7384-4179-9e2d-8879ce8df2e4"></attrib>
<attrib name="id" value="sec.2-ssec.3"></attrib>
<attrib name="status" value="repealed"></attrib></parentattributes>

<head>
<no>(3)</no></head>
<repealed><repealedtxt></repealedtxt></repealed>
</tier>


<content type="historynote"><txt break.before="1"><b>s 2:</b> Am 1959 No 32,
sec 2 (1); 1965 No 8, sec 3 (1) (a).</txt></content>
