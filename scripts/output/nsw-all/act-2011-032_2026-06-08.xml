<no>2</no><heading guid="_bf09bfe3-ecf3-414b-8233-659484a6f9ce"
id="sec.2-he"><b>Commencement</b></heading></head>
<block><txt break.before="1">This Act commences on the date of assent to this
Act.</txt></block></level>


<level type="clause" id="sec.3">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="spent.amends" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_53131d6b-9ae3-4ea4-ae87-f21184549f91"></attrib>
<attrib name="id" value="sec.3"></attrib></parentattributes>

<head>
<no>3</no><heading guid="_4f2dcde1-b4a0-4461-823b-6cffbf545049"
id="sec.3-he"><b>Object of Act</b></heading></head>
<block><txt break.before="1">The object of this Act is to establish the
Restart NSW Fund for the purpose of setting aside funding for and securing the
delivery of major infrastructure projects and other necessary
infrastructure.</txt></block></level>


<level type="clause" id="sec.4">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="spent.amends" value="0"></attrib>
