<head>
<no>1</no><heading guid="_f780a828-7964-4d2e-ba77-78fb6491eb34"
id="sec.1-he"><b>Name of Act</b></heading></head>
<block><txt break.before="1">This Act is the <legref refid="act-2011-032"
jurisd="NSW" type="act" check="unknown"><name emphasis="yes"><i>Restart NSW
Fund Act 2011</i></name></legref>.</txt></block></level>


<level type="clause" id="sec.2">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="spent.amends" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
