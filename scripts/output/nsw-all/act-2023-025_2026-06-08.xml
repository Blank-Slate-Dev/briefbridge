<head>
<no>(1)</no></head>
<block><txt break.before="1">In this Act&#8212;</txt>
<deflist>
<block><txt break.before="1"><defterm type="definition"
guid="_7f510449-7048-4c91-8565-1e2f30544795"
id="sec.3-def.services"><b><i>services</i></b></defterm> includes the
following&#8212;</txt>
<list number.type="default" unnumbered.indent="0">
<li provision.type="other" affected.by.uncommenced="0"
guid="_28418ead-2a5b-4212-85d6-9126cc025317" id="sec.3-ssec.1-para1.a">
<no>(a)</no>
<block><txt break.before="1">capital works and services,</txt></block></li>
<li provision.type="other" affected.by.uncommenced="0"
guid="_fb600bd5-158e-4763-81c1-c11fdb4f8915" id="sec.3-ssec.1-para1.b">
<no>(b)</no>
<block><txt break.before="1">recurrent services,</txt></block></li>
<li provision.type="other" affected.by.uncommenced="0"
guid="_0ed1f25b-9fb6-491a-b14d-9fd2c43e3756" id="sec.3-ssec.1-para1.c">
<no>(c)</no>
<block><txt break.before="1">repayment of debt.</txt></block></li></list>
</block>
<block><txt break.before="1"><defterm type="definition"
guid="_9cec7089-aa7c-43b8-8c24-767bad16e20a"
id="sec.3-def.year202324"><b><i>year 2023&#8211;24</i></b></defterm> means the
year from 1 July 2023 to 30 June 2024.</txt></block></deflist>
</block></tier>


