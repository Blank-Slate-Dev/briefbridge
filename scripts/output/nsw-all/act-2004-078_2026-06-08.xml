<head>
<no>1</no><heading guid="_953fd1f2-28a5-4c55-94e1-63a641bdea12"
id="sec.1-he"><b>Name of Act</b></heading></head>
<block><txt break.before="1">This Act is the <legref refid="act-2004-078"
jurisd="NSW" type="act" check="unknown"><name emphasis="yes"><i>Special
Commission of Inquiry (James Hardie Records) Act
2004</i></name></legref>.</txt></block></level>


<level type="clause" id="sec.2">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
