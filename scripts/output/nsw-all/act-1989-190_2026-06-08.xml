<attrib name="guid" value="_4fe54ed0-54ed-494b-8e34-39da3de3737c"></attrib>
<attrib name="id" value="sec.2"></attrib></parentattributes>

<head>
<no>2</no><heading guid="_03248aa3-ef8b-4e89-8cfa-a780616ae8d6"
id="sec.2-he"><b>Commencement</b></heading></head>
<block><txt break.before="1">This Act commences on a day to be appointed by
proclamation.</txt></block></level>


<level type="clause" id="sec.3">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="spent.amends" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_f8ae56b8-3a36-4525-afd4-4d5299d36c3c"></attrib>
<attrib name="id" value="sec.3"></attrib></parentattributes>

<head>
<no>3</no><heading guid="_b6e878b1-4de4-4c92-83ab-441b93cfc594"
id="sec.3-he"><b>Jurisdiction with respect to foreign land (the Mozambique
rule abolished)</b></heading></head>
<block><txt break.before="1">The jurisdiction of any court is not excluded or
limited merely because the proceedings relate to or may otherwise concern land
or immovable property situated outside New South Wales.</txt></block></level>


<level type="clause" id="sec.4">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="spent.amends" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_4edd0246-e46f-4879-9e20-d7027b4423ee"></attrib>
<attrib name="id" value="sec.4"></attrib></parentattributes>

<head>
<no>4</no><heading guid="_e08a2e7e-3b58-4a77-a0d0-03f00ba1c5a3"
id="sec.4-he"><b>Court may decline jurisdiction with respect to foreign
land</b></heading></head>
<block><txt break.before="1">A court is not required to exercise jurisdiction
under this Act if the court considers that it is not the appropriate court to
hear the proceedings.</txt></block></level>


<level type="clause" id="sec.5">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="spent.amends" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_fc6f408f-78d2-4289-ab36-840e15471515"></attrib>
<attrib name="id" value="sec.5"></attrib></parentattributes>

<head>
<no>5</no><heading guid="_881285ae-a340-4e35-b01c-c1ec0319f7c2"
id="sec.5-he"><b>Application of Act</b></heading></head>
<block><txt break.before="1">This Act applies whether the cause of action
concerned arose before, or arises after, the commencement of this
Act.</txt></block></level>
</content>


