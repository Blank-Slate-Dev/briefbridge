<head>
<no>1</no><heading guid="_c69a6f0f-d2aa-4eca-9b85-08baaeaa34c0"
id="sec.1-he"><b>Name of Act</b></heading></head>
<block><txt break.before="1">This Act may be cited as the <legref
refid="act-1989-190" jurisd="NSW" type="act" check="unknown"><name
emphasis="yes"><i>Jurisdiction of Courts (Foreign Land) Act
1989</i></name></legref>.</txt></block></level>


<level type="clause" id="sec.2">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="spent.amends" value="0"></attrib>
