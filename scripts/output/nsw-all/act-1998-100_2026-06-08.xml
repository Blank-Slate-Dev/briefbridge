<parentattributes>
<attrib name="id" value="pt.1"></attrib>
<attrib name="guid" value="_732e7781-24fc-4681-b27b-978b5636feda"></attrib>
<attrib name="affected.by.uncommenced" value="0"></attrib></parentattributes>

<head>
<no><b>Part 1</b></no><heading id="pt.1-he"
guid="_1ff4d0ed-c2b2-429d-893e-512a413c6cef"><b>Preliminary</b></heading></head>

<level type="clause" id="sec.1">
<parentattributes>
<attrib name="id" value="sec.1"></attrib>
<attrib name="guid" value="_70d074ee-4519-40fe-a229-c59181f25a7c"></attrib>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="spent.amends" value="0"></attrib>
