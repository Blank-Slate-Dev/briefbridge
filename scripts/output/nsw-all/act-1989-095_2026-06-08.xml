<head>
<no>1</no><heading guid="_f6f5d401-e838-411a-9286-f492df91b813"
id="sec.1-he"><b>Name of Act</b></heading></head>
<block><txt break.before="1">This Act may be cited as the <legref type="act"
jurisd="NSW" check="unknown" refid="act-1989-095"><name emphasis="yes"><i>Road
Improvement (Special Funding) Act
1989</i></name></legref>.</txt></block></level>


<level type="clause" id="sec.2">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="spent.amends" value="0"></attrib>
