<head>
<no>1</no><heading id="sec.1-he"
guid="_4bce14d4-4b18-4c07-a1c1-37a767e33e26"><b>Name of
Act</b></heading></head>
<block><txt break.before="1">This Act is the <legref jurisd="NSW" type="act"
refid="act-2016-051" check="unknown"><name emphasis="yes"><i>Social and
Affordable Housing NSW Fund Act
2016</i></name></legref>.</txt></block></level>


<level type="clause" id="sec.2">
<parentattributes>
<attrib name="id" value="sec.2"></attrib>
<attrib name="guid" value="_d98d8a01-1700-463e-ba83-b8d0cb8d0721"></attrib>
<attrib name="affected.by.uncommenced" value="0"></attrib>
