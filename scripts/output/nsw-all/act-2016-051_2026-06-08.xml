<head>
<no>2</no><heading id="sec.2-he"
guid="_113c1a64-ded8-4bb6-9f72-c4d60242e4a5"><b>Commencement</b></heading></head>
<block><txt break.before="1">This Act commences on the date of assent to this
Act.</txt></block></level>


<level type="clause" id="sec.3">
<parentattributes>
<attrib name="id" value="sec.3"></attrib>
