<head>
<no>1</no><heading guid="_b0e66cdf-6c7d-4175-ba11-70eefa01204f"
id="sec.1-he"><b>Name of Act</b></heading></head>
<block><txt break.before="1">This Act may be cited as the <legref
refid="act-1922-006" jurisd="NSW" type="act" check="unknown"><name
emphasis="yes"><i>Unauthorised Documents Act
1922</i></name></legref>.</txt></block></level>


<level type="clause" id="sec.2">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
<attrib name="spent.amends" value="0"></attrib>
<attrib name="provision.type" value="other"></attrib>
<attrib name="guid" value="_fb3c025f-87c5-4f39-bacc-5233d08cbaed"></attrib>
<attrib name="id" value="sec.2"></attrib></parentattributes>

<head>
<no>2</no><heading guid="_512eeb54-fb88-47ab-8013-a323b553f7a3"
id="sec.2-he"><b>Definitions</b></heading></head>
<block><txt break.before="1">In this Act, unless the context otherwise
requires:</txt>
<deflist>
<block><txt break.before="1"><defterm type="definition"
guid="_bcd05d7b-e2f7-405d-942b-e3e8939393bf"
id="def.Court"><b><i>Court</i></b></defterm> means any court of justice in the
State.</txt></block>
<block><txt break.before="1"><defterm type="definition"
guid="_693528e2-5832-41d0-bef1-4881872b4c2d"
id="def.State"><b><i>State</i></b></defterm> means State of New South
Wales.</txt></block></deflist>
</block></level>


<level type="clause" id="sec.3" status="repealed">
<parentattributes>
<attrib name="affected.by.uncommenced" value="0"></attrib>
